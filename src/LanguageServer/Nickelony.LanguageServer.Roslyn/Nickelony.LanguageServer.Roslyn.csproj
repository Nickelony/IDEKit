<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.LanguageServer.Roslyn</RootNamespace>
		<AssemblyName>Nickelony.LanguageServer.Roslyn</AssemblyName>
		<PackageId>Nickelony.LanguageServer.Roslyn</PackageId>
		<Description>C# and Visual Basic language-server provider for the Nickelony Language Server family, backed by Microsoft's Roslyn language server.</Description>
		<PackageTags>language-server;lsp;roslyn;csharp;visual-basic;intellisense;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.LanguageServer.Roslyn.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.LanguageServer.Client\Nickelony.LanguageServer.Client.csproj" />
		<ProjectReference Include="..\Nickelony.LanguageServer.Provider\Nickelony.LanguageServer.Provider.csproj" />
		<ProjectReference Include="..\..\IDEKit\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\IDEKit\Nickelony.IDEKit.FileWatching\Nickelony.IDEKit.FileWatching.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
