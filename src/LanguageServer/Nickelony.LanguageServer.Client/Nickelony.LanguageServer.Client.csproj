<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.LanguageServer.Client</RootNamespace>
		<AssemblyName>Nickelony.LanguageServer.Client</AssemblyName>
		<PackageId>Nickelony.LanguageServer.Client</PackageId>
		<Description>Lightweight LSP client for .NET built on StreamJsonRpc - spawns a language-server process and speaks LSP over stdio.</Description>
		<PackageTags>language-server;lsp;editor;intellisense;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
		<!-- CA1848 is not enforced: this package logs direct diagnostics through the ILogger extension methods (CONVENTIONS.md, rule L1). -->
		<NoWarn>$(NoWarn);CA1848</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="StreamJsonRpc" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.LanguageServer.Client.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\shared\Infrastructure\Paths\LocalPathRules.cs" Link="Infrastructure\Paths\LocalPathRules.cs" />
	</ItemGroup>
</Project>
