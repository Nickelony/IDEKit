<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.LanguageServer.Provider</RootNamespace>
		<AssemblyName>Nickelony.LanguageServer.Provider</AssemblyName>
		<PackageId>Nickelony.LanguageServer.Provider</PackageId>
		<Description>Language-neutral provider framework for the Nickelony Language Server family: lifecycle, document synchronization, workspace watching, and request machinery for building language-server providers.</Description>
		<PackageTags>language-server;lsp;editor;intellisense;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
		<!-- CA1848 is not enforced: this package logs direct diagnostics through the ILogger extension methods (CONVENTIONS.md, rule L1). -->
		<NoWarn>$(NoWarn);CA1848</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.LanguageServer.Provider.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.LanguageServer.Provider.Abstractions\Nickelony.LanguageServer.Provider.Abstractions.csproj" />
		<ProjectReference Include="..\Nickelony.LanguageServer.Client\Nickelony.LanguageServer.Client.csproj" />
		<!-- IDEKit.FileWatching supplies the watcher, the snapshot tracker and the change batches that the workspace watching builds on;
		     IDEKit.Core supplies the text primitives this package needs (incremental text edits for
		     DocumentTracker, the line map the response parsers and the semantic-token decoder use);
		     IDEKit.LanguageFeatures supplies the editor payloads the response mapping converts protocol results into. -->
		<ProjectReference Include="..\..\IDEKit\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\IDEKit\Nickelony.IDEKit.FileWatching\Nickelony.IDEKit.FileWatching.csproj" />
		<ProjectReference Include="..\..\IDEKit\Nickelony.IDEKit.LanguageFeatures\Nickelony.IDEKit.LanguageFeatures.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
