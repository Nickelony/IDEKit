<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>Nickelony.KeyBindings.Wpf</RootNamespace>
		<AssemblyName>Nickelony.KeyBindings.Wpf</AssemblyName>
		<PackageId>Nickelony.KeyBindings.Wpf</PackageId>
		<Description>WPF adapter for the toolkit-neutral Nickelony.KeyBindings command surface: WPF key and modifier mapping, KeyEventArgs conversion, key-down dispatch, and the WPF gesture display formatter for desktop WPF hosts.</Description>
		<PackageTags>wpf;commands;shortcuts;key-bindings;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.KeyBindings\Nickelony.KeyBindings.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The shared key table is compiled into both adapters; the AVALONIAKEYBINDINGS define picks the toolkit branch. -->
		<Compile Include="..\..\..\shared\KeyBindings\KeyCodeConversionTable.cs" Link="KeyCodeConversionTable.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
