<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.KeyBindings.Avalonia</RootNamespace>
		<AssemblyName>Nickelony.KeyBindings.Avalonia</AssemblyName>
		<PackageId>Nickelony.KeyBindings.Avalonia</PackageId>
		<Description>Avalonia adapter for the toolkit-neutral Nickelony.KeyBindings command surface: Avalonia key and modifier mapping, KeyEventArgs conversion, and key-down dispatch for desktop Avalonia hosts.</Description>
		<PackageTags>avalonia;commands;shortcuts;key-bindings;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<DefineConstants>$(DefineConstants);AVALONIAKEYBINDINGS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia is cross-platform, so this adapter targets net8.0 (not net8.0-windows); only the
		     input model (Avalonia.Input) is used. -->
		<PackageReference Include="Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.KeyBindings\Nickelony.KeyBindings.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared with the WPF adapter; the AVALONIAKEYBINDINGS define (set above) picks this table's Avalonia branch. -->
		<Compile Include="..\..\..\shared\KeyBindings\KeyCodeConversionTable.cs" Link="KeyCodeConversionTable.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
