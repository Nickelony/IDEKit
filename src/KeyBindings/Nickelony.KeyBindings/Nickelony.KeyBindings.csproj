<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.KeyBindings</RootNamespace>
		<AssemblyName>Nickelony.KeyBindings</AssemblyName>
		<PackageId>Nickelony.KeyBindings</PackageId>
		<Description>Toolkit-neutral (WPF/Avalonia-independent) command and keyboard shortcut system for desktop keyboards: command catalog, key bindings, persisted overrides, validation, rebinding, and key dispatch.</Description>
		<PackageTags>commands;shortcuts;key-bindings;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<!-- The test suite reaches internal types directly: the persisted-override codec, the conflict detector and the modifier masks. -->
		<InternalsVisibleTo Include="Nickelony.KeyBindings.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
