<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.IDEKit.Workspace.QuickPick</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.Workspace.QuickPick</AssemblyName>
		<PackageId>Nickelony.IDEKit.Workspace.QuickPick</PackageId>
		<Description>UI-framework-free file list of a quick open: the files below the workspace roots, kept current by file watchers, as the files mode of a Nickelony quick pick.</Description>
		<PackageTags>quick-open;quick-pick;file-list;workspace;file-system;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\Nickelony.IDEKit.FileWatching\Nickelony.IDEKit.FileWatching.csproj" />
		<ProjectReference Include="..\..\QuickPick\Nickelony.QuickPick\Nickelony.QuickPick.csproj" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.Workspace.QuickPick.Tests" />
	</ItemGroup>
</Project>
