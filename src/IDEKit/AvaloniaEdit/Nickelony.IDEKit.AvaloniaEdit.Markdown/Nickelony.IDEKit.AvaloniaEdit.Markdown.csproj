<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Avalonia is cross-platform, so this binding targets net8.0, not net8.0-windows. -->
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.IDEKit.AvaloniaEdit.Markdown</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvaloniaEdit.Markdown</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvaloniaEdit.Markdown</PackageId>
		<Description>Markdown rendering for AvaloniaEdit editors: a Markdig-backed renderer that produces native Avalonia content trees and embedded AvaloniaEdit code blocks.</Description>
		<PackageTags>text-editor;editor;avaloniaedit;avalonia;markdown;tooltip;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<EditorEngine>Avalonia</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia and Avalonia.AvaloniaEdit are both direct references, versioned by Directory.Packages.props;
		     the content model and embedded code-block editors use Avalonia.Controls / AvaloniaEdit directly. -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.AvaloniaEdit\Nickelony.IDEKit.AvaloniaEdit.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Markdown\Nickelony.IDEKit.Markdown.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.Markdown and keeps the folder, and the engine half of the code-block factory is an own file of this project (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.Markdown\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.Markdown.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
