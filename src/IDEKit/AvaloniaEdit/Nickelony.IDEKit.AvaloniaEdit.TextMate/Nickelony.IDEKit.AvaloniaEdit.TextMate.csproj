<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Avalonia is cross-platform, so this binding targets net8.0, not net8.0-windows. -->
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.IDEKit.AvaloniaEdit.TextMate</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvaloniaEdit.TextMate</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvaloniaEdit.TextMate</PackageId>
		<Description>TextMate syntax-highlighting for AvaloniaEdit editors: a session that colors a text view from a TextMate grammar and the neutral Nickelony.IDEKit.TextMate theme model, built on TextMateSharp, on top of Nickelony.IDEKit.AvaloniaEdit.</Description>
		<PackageTags>text-editor;editor;avaloniaedit;avalonia;textmate;syntax-highlighting;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<EditorEngine>Avalonia</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia and Avalonia.AvaloniaEdit are both direct references, versioned by Directory.Packages.props. -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="TextMateSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.AvaloniaEdit\Nickelony.IDEKit.AvaloniaEdit.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.TextMate\Nickelony.IDEKit.TextMate.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.TextMate (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.TextMate\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.TextMate.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
