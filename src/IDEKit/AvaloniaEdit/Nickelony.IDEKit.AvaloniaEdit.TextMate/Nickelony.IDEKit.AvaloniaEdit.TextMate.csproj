<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nickelony.IDEKit.AvaloniaEdit.TextMate</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvaloniaEdit.TextMate</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvaloniaEdit.TextMate</PackageId>
    <Description>TextMate syntax-highlighting infrastructure for AvaloniaEdit editors: a colorizing transformer, a document line-list adapter, and a token-theme style resolver built on TextMateSharp, on top of Nickelony.IDEKit.AvaloniaEdit.</Description>
    <PackageTags>text-editor;editor;avaloniaedit;avalonia;textmate;syntax-highlighting;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
    <!-- Selects the AvaloniaEdit branch of the shared binding source under shared\Editor.TextMate. -->
    <DefineConstants>$(DefineConstants);AVALONIAEDIT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia is cross-platform, so this adapter targets net8.0 (not net8.0-windows). The direct
         reference takes the repo pin (12.1.3); Avalonia.AvaloniaEdit 12.0.0 flows from it. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="TextMateSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.AvaloniaEdit\Nickelony.IDEKit.AvaloniaEdit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\shared\Infrastructure\BrushHelpers.Avalonia.cs" Link="Infrastructure\BrushHelpers.Avalonia.cs" />
    <!-- Shared binding source: one file compiled into the AvalonEdit and AvaloniaEdit TextMate
         packages, with a per-binding namespace and engine using selected by the AVALONIAEDIT define. -->
    <Compile Include="..\..\..\..\shared\Editor.TextMate\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.TextMate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
