<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Avalonia is cross-platform, so this binding targets net8.0, not net8.0-windows. -->
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.IDEKit.AvaloniaEdit.LanguageFeatures</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvaloniaEdit.LanguageFeatures</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvaloniaEdit.LanguageFeatures</PackageId>
		<Description>AvaloniaEdit language-feature UI controllers: completion windows, hover tooltips, signature help, definition navigation, code actions, and semantic-token colorizing, built on Nickelony.IDEKit.Core, Nickelony.IDEKit.LanguageFeatures, Nickelony.IDEKit.LanguageFeatures.Controllers, and Nickelony.IDEKit.AvaloniaEdit.</Description>
		<PackageTags>text-editor;editor;avaloniaedit;avalonia;intellisense;completion;hover;signature-help;definition-navigation;code-actions;quick-fix;semantic-tokens;tooltip;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<EditorEngine>Avalonia</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia and Avalonia.AvaloniaEdit are both direct references, versioned by Directory.Packages.props;
		     the controllers use Avalonia.Media / Avalonia.Controls directly. -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.LanguageFeatures\Nickelony.IDEKit.LanguageFeatures.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.LanguageFeatures.Controllers\Nickelony.IDEKit.LanguageFeatures.Controllers.csproj" />
		<ProjectReference Include="..\Nickelony.IDEKit.AvaloniaEdit\Nickelony.IDEKit.AvaloniaEdit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.LanguageFeatures and keeps its folder, so Completion\ holds the project's own files beside the shared ones (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.LanguageFeatures\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.LanguageFeatures.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
