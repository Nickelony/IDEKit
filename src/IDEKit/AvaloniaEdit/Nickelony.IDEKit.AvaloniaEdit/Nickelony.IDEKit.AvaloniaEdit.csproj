<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nickelony.IDEKit.AvaloniaEdit</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvaloniaEdit</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvaloniaEdit</PackageId>
    <Description>AvaloniaEdit UI bridge: editing, document, and status services for cross-platform Avalonia (AvaloniaEdit) text editors, built on Nickelony.IDEKit.Core.</Description>
    <PackageTags>text-editor;editor;avaloniaedit;avalonia;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
    <!-- Selects the AvaloniaEdit branch of the shared binding source under shared\Editor. -->
    <DefineConstants>$(DefineConstants);AVALONIAEDIT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia is cross-platform, so this adapter targets net8.0 (not net8.0-windows). The direct
         reference takes the repo pin (12.1.3); Avalonia.AvaloniaEdit 12.0.0 flows from it, and the
         margins, renderers, and colorizers use Avalonia.Media / Avalonia.Input directly. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\shared\Infrastructure\TextMatchProbe.cs" Link="Infrastructure\TextMatchProbe.cs" />
    <Compile Include="..\..\..\..\shared\Infrastructure\BrushHelpers.Avalonia.cs" Link="Infrastructure\BrushHelpers.Avalonia.cs" />
    <!-- Shared binding source: one file compiled into the AvalonEdit and AvaloniaEdit bindings, with a
         per-binding namespace and engine using selected by the AVALONIAEDIT define. -->
    <Compile Include="..\..\..\..\shared\Editor\Documents\TextDocumentSnapshot.cs" Link="Documents\TextDocumentSnapshot.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Bookmarks\BookmarkStoreExtensions.cs" Link="Bookmarks\BookmarkStoreExtensions.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Bookmarks\IBookmarkSource.cs" Link="Bookmarks\IBookmarkSource.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\AutoClosingInsertionTracker.cs" Link="Editing\AutoClosingInsertionTracker.cs" />
    <Compile Include="..\..\..\..\shared\Editor\ChangeMarkers\UnsavedChangesTracker.cs" Link="ChangeMarkers\UnsavedChangesTracker.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Bookmarks\BookmarkCoordinator.cs" Link="Bookmarks\BookmarkCoordinator.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Comments\ITextLineCommentService.cs" Link="Comments\ITextLineCommentService.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Comments\TextLineCommentService.cs" Link="Comments\TextLineCommentService.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Documents\DocumentLineStateCache.cs" Link="Documents\DocumentLineStateCache.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Documents\DocumentVersionCache.cs" Link="Documents\DocumentVersionCache.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Documents\TextDocumentExtensions.cs" Link="Documents\TextDocumentExtensions.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\DocumentTextMatch.cs" Link="Editing\DocumentTextMatch.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\ITextDocumentFormattingService.cs" Link="Editing\ITextDocumentFormattingService.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\TextEditorLineOperations.cs" Link="Editing\TextEditorLineOperations.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Indentation\PolicyIndentationStrategy.cs" Link="Indentation\PolicyIndentationStrategy.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\TextDocumentFormattingService.cs" Link="Editing\TextDocumentFormattingService.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\TextEditorEditOperations.cs" Link="Editing\TextEditorEditOperations.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\TextEditorEditTarget.cs" Link="Editing\TextEditorEditTarget.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Highlighting\RegexHighlightingDefinition.cs" Link="Highlighting\RegexHighlightingDefinition.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Highlighting\RegexHighlightingDefinitionOptions.cs" Link="Highlighting\RegexHighlightingDefinitionOptions.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Navigation\TextAreaNavigationOperations.cs" Link="Navigation\TextAreaNavigationOperations.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Rendering\ITextRunStyle.cs" Link="Rendering\ITextRunStyle.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Rendering\TextRunStyle.cs" Link="Rendering\TextRunStyle.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Bookmarks\BookmarkMarginTestHooks.cs" Link="Bookmarks\BookmarkMarginTestHooks.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\ITextAutoClosingService.cs" Link="Editing\ITextAutoClosingService.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Highlighting\RegexHighlightingStyleExtensions.cs" Link="Highlighting\RegexHighlightingStyleExtensions.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Rendering\TextRunStyleApplier.cs" Link="Rendering\TextRunStyleApplier.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Navigation\TextEditorNavigationOperations.cs" Link="Navigation\TextEditorNavigationOperations.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Diagnostics\DiagnosticsRenderer.cs" Link="Diagnostics\DiagnosticsRenderer.cs" />
    <Compile Include="..\..\..\..\shared\Editor\Editing\TextAutoClosingService.cs" Link="Editing\TextAutoClosingService.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
