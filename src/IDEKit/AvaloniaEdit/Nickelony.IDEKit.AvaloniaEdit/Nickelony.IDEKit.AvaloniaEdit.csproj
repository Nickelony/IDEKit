<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Avalonia is cross-platform, so this binding targets net8.0, not net8.0-windows. -->
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Nickelony.IDEKit.AvaloniaEdit</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvaloniaEdit</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvaloniaEdit</PackageId>
		<Description>AvaloniaEdit UI binding: editing, document, and status services for cross-platform Avalonia (AvaloniaEdit) text editors, built on Nickelony.IDEKit.Core.</Description>
		<PackageTags>text-editor;editor;avaloniaedit;avalonia;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<EditorEngine>Avalonia</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia and Avalonia.AvaloniaEdit are both direct references, versioned by Directory.Packages.props;
		     the margins, renderers, and colorizers use Avalonia.Media / Avalonia.Input directly. -->
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: this one wildcard links every file below shared/Editor and keeps its folder, so a folder such as Bookmarks\ holds the project's own files beside the shared ones of shared/Editor/Bookmarks (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvaloniaEdit.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
