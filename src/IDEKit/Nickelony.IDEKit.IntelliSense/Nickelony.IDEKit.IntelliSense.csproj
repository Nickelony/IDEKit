<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.IDEKit.IntelliSense</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.IntelliSense</AssemblyName>
    <PackageId>Nickelony.IDEKit.IntelliSense</PackageId>
    <Description>Editor- and protocol-agnostic IntelliSense contracts, payloads, host-state records, and shared session helpers with no third-party dependencies: code actions, completion, diagnostics, document symbols, hover, navigation, semantic tokens, and signature help.</Description>
    <PackageTags>text-editor;editor;intellisense;completion;diagnostics;hover;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\shared\Infrastructure\OptionalText.cs" Link="Infrastructure\OptionalText.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
