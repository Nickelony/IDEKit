<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.IDEKit.Workspace.Views</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.Workspace.Views</AssemblyName>
		<PackageId>Nickelony.IDEKit.Workspace.Views</PackageId>
		<Description>UI-framework-free document-view coordination for the Nickelony workspace document authority: the document-view contract and the coordinator that synchronizes attached views with tracked documents. It has no UI-framework dependency and takes an injectable dispatcher, so any toolkit binding can host it.</Description>
		<PackageTags>documents;workspace;views;ide;host-agnostic;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.Workspace.Views.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\Nickelony.IDEKit.LanguageFeatures\Nickelony.IDEKit.LanguageFeatures.csproj" />
		<ProjectReference Include="..\Nickelony.IDEKit.Workspace\Nickelony.IDEKit.Workspace.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
