<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.IDEKit.JsonSchema</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.JsonSchema</AssemblyName>
		<PackageId>Nickelony.IDEKit.JsonSchema</PackageId>
		<Description>Experimental JSON Schema vocabulary index for schema-driven completion, hover, and highlighting; it is not a validator.</Description>
		<PackageTags>json;schema;jsonschema;text-editor;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
