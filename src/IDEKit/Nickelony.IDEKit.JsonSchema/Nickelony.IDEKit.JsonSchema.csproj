<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.IDEKit.JsonSchema</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.JsonSchema</AssemblyName>
    <PackageId>Nickelony.IDEKit.JsonSchema</PackageId>
    <Description>JSON Schema index building for schema-driven completion, hover, and highlighting.</Description>
    <PackageTags>json;schema;jsonschema;text-editor;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json.Schema" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
