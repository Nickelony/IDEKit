<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.IDEKit.Core</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.Core</AssemblyName>
		<PackageId>Nickelony.IDEKit.Core</PackageId>
		<Description>Dependency-free text snapshots, ranges, edits, and host-independent editor utilities and contracts.</Description>
		<PackageTags>text-editor;editor;text;utilities;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\shared\Infrastructure\Paths\LocalPathRules.cs" Link="Infrastructure\Paths\LocalPathRules.cs" />
		<!-- The primitives live in shared/Primitives, where the standalone quick-pick family compiles them as internal types of its own. -->
		<Compile Include="..\..\..\shared\Primitives\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
