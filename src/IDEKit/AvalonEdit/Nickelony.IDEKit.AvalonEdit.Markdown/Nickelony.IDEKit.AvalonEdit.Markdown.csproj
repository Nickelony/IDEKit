<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EditorEngine>Wpf</EditorEngine>
		<RootNamespace>Nickelony.IDEKit.AvalonEdit.Markdown</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvalonEdit.Markdown</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvalonEdit.Markdown</PackageId>
		<Description>Markdown rendering for AvalonEdit editors: a Markdig-backed renderer that produces WPF FlowDocuments and embedded AvalonEdit code blocks.</Description>
		<PackageTags>text-editor;editor;avalonedit;wpf;markdown;tooltip;flowdocument;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.Markdown and keeps the folder, and the engine half of the code-block factory is an own file of this project (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.Markdown\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Markdown\Nickelony.IDEKit.Markdown.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.Markdown.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
