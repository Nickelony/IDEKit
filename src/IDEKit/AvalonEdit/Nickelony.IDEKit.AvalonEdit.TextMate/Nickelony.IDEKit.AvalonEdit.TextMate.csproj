<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nickelony.IDEKit.AvalonEdit.TextMate</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvalonEdit.TextMate</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvalonEdit.TextMate</PackageId>
    <Description>TextMate syntax-highlighting infrastructure for AvalonEdit editors: a colorizing transformer, a document line-list adapter, and a token-theme style resolver built on TextMateSharp, on top of Nickelony.IDEKit.AvalonEdit.</Description>
    <PackageTags>text-editor;editor;avaloneditor;wpf;textmate;syntax-highlighting;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="TextMateSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\shared\Infrastructure\BrushHelpers.cs" Link="Infrastructure\BrushHelpers.cs" />
    <!-- Shared binding source: one file compiled into the AvalonEdit and AvaloniaEdit TextMate
         packages, with a per-binding namespace and engine using selected by the AVALONIAEDIT define. -->
    <Compile Include="..\..\..\..\shared\Editor.TextMate\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.TextMate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
