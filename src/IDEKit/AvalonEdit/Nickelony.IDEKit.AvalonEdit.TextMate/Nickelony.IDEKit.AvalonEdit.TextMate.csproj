<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EditorEngine>Wpf</EditorEngine>
		<RootNamespace>Nickelony.IDEKit.AvalonEdit.TextMate</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvalonEdit.TextMate</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvalonEdit.TextMate</PackageId>
		<Description>TextMate syntax-highlighting for AvalonEdit editors: a session that colors a text view from a TextMate grammar and the neutral Nickelony.IDEKit.TextMate theme model, built on TextMateSharp, on top of Nickelony.IDEKit.AvalonEdit.</Description>
		<PackageTags>text-editor;editor;avalonedit;wpf;textmate;syntax-highlighting;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="TextMateSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.TextMate\Nickelony.IDEKit.TextMate.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.TextMate (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.TextMate\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.TextMate.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
