<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EditorEngine>Wpf</EditorEngine>
		<RootNamespace>Nickelony.IDEKit.AvalonEdit</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvalonEdit</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvalonEdit</PackageId>
		<Description>AvalonEdit UI binding: editing, document, and status services for WPF text editors, built on Nickelony.IDEKit.Core.</Description>
		<PackageTags>text-editor;editor;avalonedit;wpf;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: this one wildcard links every file below shared/Editor and keeps its folder, so a folder such as Bookmarks\ holds the project's own files beside the shared ones of shared/Editor/Bookmarks (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
