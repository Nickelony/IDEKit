<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EditorEngine>Wpf</EditorEngine>
		<RootNamespace>Nickelony.IDEKit.AvalonEdit.LanguageFeatures</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.AvalonEdit.LanguageFeatures</AssemblyName>
		<PackageId>Nickelony.IDEKit.AvalonEdit.LanguageFeatures</PackageId>
		<Description>AvalonEdit language-feature UI controllers: completion windows, hover tooltips, signature help, definition navigation, code actions, and semantic-token colorizing, built on Nickelony.IDEKit.Core, Nickelony.IDEKit.LanguageFeatures, Nickelony.IDEKit.LanguageFeatures.Controllers, and Nickelony.IDEKit.AvalonEdit.</Description>
		<PackageTags>text-editor;editor;avalonedit;wpf;intellisense;completion;hover;signature-help;definition-navigation;code-actions;quick-fix;semantic-tokens;tooltip;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
		<ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.LanguageFeatures\Nickelony.IDEKit.LanguageFeatures.csproj" />
		<ProjectReference Include="..\..\Nickelony.IDEKit.LanguageFeatures.Controllers\Nickelony.IDEKit.LanguageFeatures.Controllers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared source: the wildcard links every file below shared/Editor.LanguageFeatures and keeps its folder, so Completion\ holds the project's own files beside the shared ones (see https://github.com/Nickelony/LanguageServer/blob/main/docs/EditorSharingGuide.md). -->
		<Compile Include="..\..\..\..\shared\Editor.LanguageFeatures\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.LanguageFeatures.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
