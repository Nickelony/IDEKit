<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Nickelony.IDEKit.LanguageFeatures</RootNamespace>
		<AssemblyName>Nickelony.IDEKit.LanguageFeatures</AssemblyName>
		<PackageId>Nickelony.IDEKit.LanguageFeatures</PackageId>
		<Description>Editor- and protocol-agnostic language-feature contracts and payload records, built on Nickelony.IDEKit.Core: code actions, completion, diagnostics, document and workspace symbols, formatting, hover, navigation, rename, semantic tokens, and signature help.</Description>
		<PackageTags>text-editor;editor;intellisense;completion;diagnostics;hover;nickelony</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>RS0016;RS0017</WarningsAsErrors>
		<RequireConfigureAwait>true</RequireConfigureAwait>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nickelony.IDEKit.LanguageFeatures.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
