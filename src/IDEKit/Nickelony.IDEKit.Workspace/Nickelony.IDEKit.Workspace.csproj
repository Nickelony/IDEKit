<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.IDEKit.Workspace</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.Workspace</AssemblyName>
    <PackageId>Nickelony.IDEKit.Workspace</PackageId>
    <Description>UI-framework-free workspace document authority: logical document ownership, persistence state, and file-system coordination with a pluggable file system.</Description>
    <PackageTags>text-editor;editor;documents;workspace;file-system;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public-API surface baseline: an unlisted public member fails the build (RS0016/RS0017). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\icons\$(PackageIcon)" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nickelony.IDEKit.Workspace.Tests" />
  </ItemGroup>

</Project>