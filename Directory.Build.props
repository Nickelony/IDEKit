<Project>
	<PropertyGroup>
		<TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
		<LangVersion Condition="'$(LangVersion)' == ''">12</LangVersion>
		<Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
		<ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>

		<VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
		<VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.43</VersionSuffix>
		<Version Condition="'$(Version)' == ''">$(VersionPrefix)-$(VersionSuffix)</Version>
		<AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>

		<Authors Condition="'$(Authors)' == ''">Kewin Kupilas</Authors>
		<RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/Nickelony/LanguageServer</RepositoryUrl>
		<RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
		<PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/Nickelony/LanguageServer</PackageProjectUrl>
		<DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
		<DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
		<IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
		<SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
		<IncludeSourceRevisionInInformationalVersion Condition="'$(IncludeSourceRevisionInInformationalVersion)' == ''"
			>true</IncludeSourceRevisionInInformationalVersion>
		<PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
		<PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
		<Copyright Condition="'$(Copyright)' == ''">Copyright © Kewin Kupilas 2026</Copyright>
	</PropertyGroup>

	<!--
		Per-family package icon: IDEKit is the family default, with LanguageServer.png for the LanguageServer
		packages and KeyBindings.png for the KeyBindings packages. Each project's `icons\$(PackageIcon)` Pack
		item reads this value, so the icon is set here and not in the project file.
	-->
	<PropertyGroup>
		<PackageIcon Condition="'$(PackageIcon)' == '' and $(MSBuildProjectName.StartsWith('Nickelony.LanguageServer'))"
			>LanguageServer.png</PackageIcon>
		<PackageIcon Condition="'$(PackageIcon)' == '' and $(MSBuildProjectName.StartsWith('Nickelony.KeyBindings'))">KeyBindings.png</PackageIcon>
		<PackageIcon Condition="'$(PackageIcon)' == ''">IDEKit.png</PackageIcon>
	</PropertyGroup>

	<!--
		NuGet supply-chain hygiene: the audit knobs are pinned instead of inherited so the policy cannot
		drift with the SDK (`all` audits the transitive graph, where advisories usually land), and a release
		must show a restore with no NU1901-NU1904 finding. Package source mapping and packages.lock.json are
		not adopted: every version is exact, and the repository adds no package feed. Revisit the mapping and the
		lock file when a feed or a floating version is added.
	-->
	<PropertyGroup>
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditMode>all</NuGetAuditMode>
		<NuGetAuditLevel>low</NuGetAuditLevel>
	</PropertyGroup>

	<!--
		The Stanza rules (ZA00xx/ZA01xx/ZA02xx) load solution-wide through an analyzer reference to a local
		checkout of the Stanza repository, so the assembly runs in the compiler and no project gains a runtime
		dependency. StanzaRepoRoot names the checkout, and it defaults to the sibling `Stanza` folder of this
		repository. The checkout must contain `src\Nickelony.Stanza.Analyzers\Nickelony.Stanza.Analyzers.csproj`
		and the `src\Nickelony.Stanza.Markup.Core` sources that project compiles. Set it with
		`-p:StanzaRepoRoot=<path>` or an environment variable of the same name to build against another checkout.
		When the analyzer project is missing there, the reference is dropped and every ZA pin in .editorconfig
		has no effect. The code fixes ship in a second assembly, `src\Nickelony.Stanza.Analyzers.CodeFixes`, and
		`dotnet format` finds a fix only when that assembly is referenced too; without it every ZA diagnostic still
		reports, but format.ps1 reports "No associated code fix found" and rewrites nothing. The solution lists
		neither project, so a whole-solution `dotnet format` never rewrites the Stanza checkout.
	-->
	<PropertyGroup>
		<StanzaRepoRoot Condition="'$(StanzaRepoRoot)' == ''"
			>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Stanza'))</StanzaRepoRoot>
	</PropertyGroup>

	<ItemGroup Condition="Exists('$(StanzaRepoRoot)\src\Nickelony.Stanza.Analyzers\Nickelony.Stanza.Analyzers.csproj')">
		<ProjectReference
			Include="$(StanzaRepoRoot)\src\Nickelony.Stanza.Analyzers\Nickelony.Stanza.Analyzers.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<ItemGroup Condition="Exists('$(StanzaRepoRoot)\src\Nickelony.Stanza.Analyzers.CodeFixes\Nickelony.Stanza.Analyzers.CodeFixes.csproj')">
		<ProjectReference
			Include="$(StanzaRepoRoot)\src\Nickelony.Stanza.Analyzers.CodeFixes\Nickelony.Stanza.Analyzers.CodeFixes.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
