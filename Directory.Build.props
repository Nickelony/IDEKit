<Project>

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">12</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>

    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.43</VersionSuffix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>

    <Authors Condition="'$(Authors)' == ''">Kewin Kupilas</Authors>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/Nickelony/LanguageServer</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/Nickelony/LanguageServer</PackageProjectUrl>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">See the release notes in the repository: https://github.com/Nickelony/LanguageServer/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(IncludeSourceRevisionInInformationalVersion)' == ''">true</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
    <Copyright Condition="'$(Copyright)' == ''">Copyright © Kewin Kupilas 2026</Copyright>
  </PropertyGroup>

  <!--
    Per-family package icon. Each product family ships its own mark and packs it at the package
    root: IDEKit is the family default (IDEKit.png), while the Language Server keeps
    LanguageServer.png and KeyBindings carries KeyBindings.png. The name is derived from the package
    id, so a family member names the asset once - its `icons\$(PackageIcon)` Pack item uses the same
    value this metadata publishes.
  -->
  <PropertyGroup>
    <PackageIcon Condition="'$(PackageIcon)' == '' and $(MSBuildProjectName.StartsWith('Nickelony.LanguageServer'))">LanguageServer.png</PackageIcon>
    <PackageIcon Condition="'$(PackageIcon)' == '' and $(MSBuildProjectName.StartsWith('Nickelony.KeyBindings'))">KeyBindings.png</PackageIcon>
    <PackageIcon Condition="'$(PackageIcon)' == ''">IDEKit.png</PackageIcon>
  </PropertyGroup>

  <!--
    NuGet supply-chain hygiene.

    The audit knobs are pinned instead of inherited so the policy cannot drift with the SDK: this
    repository targets net8.0, where the SDK default audit mode is `direct`, and `all` audits the
    transitive graph too, which is where advisories usually land. A finding is NuGet's own warning
    rather than a build error - clearing one needs a package bump the repository cannot make by
    itself - so the rule is instead that a release must show a restore with no NU1901-NU1904 finding.

    Deliberately not adopted: package source mapping (every dependency is an exact version pinned in
    Directory.Packages.props and resolves from the single public nuget.org source, so there is no
    second feed an id could be confused with) and packages.lock.json (no version floats, so the
    resolved graph is already deterministic). Both return to the table when a private feed, a
    floating version, or a CI leg is introduced.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
