<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<EditorEngine>Avalonia</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\samples\Nickelony.Samples.Avalonia\Nickelony.Samples.Avalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\TestSupport\TemporaryDirectory.cs" Link="TestSupport\TemporaryDirectory.cs" />
		<Compile Include="..\..\TestSupport\TestCategories.cs" Link="TestSupport\TestCategories.cs" />
		<!-- The shared sample tests: one body compiled into the WPF and the Avalonia suites, with the namespace and the engine usings selected by the AVALONIAEDIT define. -->
		<Compile Include="..\Shared\Samples.Tests\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
		<!-- The headless session runs every test on its UI thread, so the class attribute of the WPF suite needs no thread of its own here. -->
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute" Alias="STATestClassAttribute" />
		<Using Include="Nickelony.Testing" />
	</ItemGroup>
</Project>
