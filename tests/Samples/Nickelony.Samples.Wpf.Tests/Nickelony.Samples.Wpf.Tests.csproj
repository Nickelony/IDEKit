<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<EditorEngine>Wpf</EditorEngine>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\samples\Nickelony.Samples.Wpf\Nickelony.Samples.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\TestSupport\TemporaryDirectory.cs" Link="TestSupport\TemporaryDirectory.cs" />
		<Compile Include="..\..\TestSupport\TestCategories.cs" Link="TestSupport\TestCategories.cs" />
		<!-- The shared sample tests: one body compiled into the WPF and the Avalonia suites, with the namespace and the engine usings selected by the AVALONIAEDIT define. -->
		<Compile Include="..\Shared\Samples.Tests\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
		<Using Include="Nickelony.Testing" />
	</ItemGroup>
</Project>
