<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      Many tests park a store or text-edit operation on a rendezvous gate and await the manager's
      reaction. The session timeout turns a wedged gate into a failed run instead of an indefinitely
      hanging one; the budget stays deliberately generous so a loaded machine cannot abort a healthy
      session.
    -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
