<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      The suite drives real child processes, including a child that writes more than the pipe buffer and a
      detached descendant that holds the redirected pipe. The session timeout turns a wedged child or a
      stalled termination into a failed run instead of an indefinitely hanging one; the budget stays
      deliberately generous so a loaded machine cannot abort a healthy session.
    -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
