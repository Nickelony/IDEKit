<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EditorEngine>Wpf</EditorEngine>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="TextMateSharp.Grammars" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\src\IDEKit\AvalonEdit\Nickelony.IDEKit.AvalonEdit.TextMate\Nickelony.IDEKit.AvalonEdit.TextMate.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\TestSupport\WpfTestHost.cs" Link="TestSupport\WpfTestHost.cs" />
		<Compile Include="..\..\..\TestSupport\Wpf\WpfToolkitTestHost.cs" Link="TestSupport\WpfToolkitTestHost.cs" />
		<Compile Include="..\..\..\TestSupport\Wpf\HostWindow.cs" Link="TestSupport\HostWindow.cs" />
		<Compile Include="..\..\..\TestSupport\RecordingLogger.cs" Link="TestSupport\RecordingLogger.cs" />
		<!-- Shared binding tests: one body compiled into the AvalonEdit and AvaloniaEdit suites, with a
		     per-binding namespace, engine using, and test-class attribute selected by the AVALONIAEDIT define. -->
		<Compile Include="..\..\Shared\Editor.TextMate.Tests\**\*.cs" LinkBase="." />
		<Compile Include="..\..\..\TestSupport\TestCategories.cs" Link="TestSupport\TestCategories.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
		<Using Include="Nickelony.IDEKit.TextMate" />
		<Using Include="Nickelony.IDEKit.Testing" />
		<Using Include="Nickelony.IDEKit.Testing.WpfTestHost" Alias="TestHost" />
		<Using Include="Nickelony.Testing" />
	</ItemGroup>
</Project>
