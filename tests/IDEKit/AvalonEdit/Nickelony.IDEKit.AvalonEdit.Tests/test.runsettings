<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      The suite runs WPF dispatcher, rendering, and bookmark tests with no per-test timeout; some park work
      on gates and await the editor's reaction. The session timeout turns a wedged test into a failed run
      instead of an indefinitely hanging one; the budget stays deliberately generous so a loaded machine
      cannot abort a healthy session.
    -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
