<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      Several tests park a document-store operation on a gate and await the view's reaction, and a few
      spin on a bounded condition. The session timeout turns a wedged gate into a failed run instead of
      an indefinitely hanging one; the budget stays deliberately generous so a loaded machine cannot
      abort a healthy session.
    -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
