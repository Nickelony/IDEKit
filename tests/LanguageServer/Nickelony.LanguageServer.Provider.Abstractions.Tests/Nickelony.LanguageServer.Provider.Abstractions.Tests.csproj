<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- The suite has a longer legitimate worst case than the default session timeout of tests/test.runsettings. -->
		<VSTestCLIRunSettings>RunConfiguration.TestSessionTimeout=600000</VSTestCLIRunSettings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\src\LanguageServer\Nickelony.LanguageServer.Provider.Abstractions\Nickelony.LanguageServer.Provider.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>
</Project>
