<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      The provider tests await the provider's reaction to a notification sent through the fake client; the
      session timeout turns a wedged wait into a failed run instead of an indefinitely hanging one. The
      budget stays deliberately generous so a loaded machine cannot abort a healthy session.
    -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
