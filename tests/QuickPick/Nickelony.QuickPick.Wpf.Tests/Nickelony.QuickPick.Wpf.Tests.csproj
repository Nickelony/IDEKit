<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\src\QuickPick\Nickelony.QuickPick.Wpf\Nickelony.QuickPick.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\TestSupport\WpfTestHost.cs" Link="TestSupport\WpfTestHost.cs" />
		<Compile Include="..\..\TestSupport\Wpf\WpfToolkitTestHost.cs" Link="TestSupport\WpfToolkitTestHost.cs" />
		<Compile Include="..\..\TestSupport\Wpf\HostWindow.cs" Link="TestSupport\HostWindow.cs" />
		<Compile Include="..\..\TestSupport\Wpf\TestWindowActivation.cs" Link="TestSupport\TestWindowActivation.cs" />
		<Compile Include="..\..\TestSupport\Wpf\DispatcherTestHelpers.cs" Link="TestSupport\DispatcherTestHelpers.cs" />
		<Compile Include="..\..\TestSupport\TestCategories.cs" Link="TestSupport\TestCategories.cs" />
		<!-- Shared presenter tests: one body compiled into the WPF and the Avalonia suites, with a per-toolkit namespace and using selected by the AVALONIAQUICKPICK define. -->
		<Compile Include="..\Shared\Presenter.Tests\**\*.cs" LinkBase="." />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
		<Using Include="Nickelony.QuickPick.Testing" />
		<Using Include="Nickelony.QuickPick.Testing.WpfTestHost" Alias="TestHost" />
		<Using Include="Nickelony.Testing" />
	</ItemGroup>
</Project>
