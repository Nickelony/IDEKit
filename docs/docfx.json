{
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/*.csproj" ],
          "src": "../src"
        }
      ],
      "namespaceLayout": "nested",
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "toc.yml", "*.md" ],
        "exclude": [ "_site/**", "api/**" ]
      },
      {
        "files": [ "*.yml" ],
        "src": "api",
        "dest": "api"
      }
    ],
    "resource": [
      { "files": [ "IDEKit.svg", "IDEKit.png" ], "src": "../icons", "dest": "images" }
    ],
    "dest": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appTitle": "Nickelony IDE and language tooling",
      "_appName": "Nickelony IDE and language tooling",
      "_appLogoPath": "images/IDEKit.svg",
      "_appFaviconPath": "images/IDEKit.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_appFooter": "Nickelony IDE and language tooling - MIT © 2026 Kewin Kupilas"
    },
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
