<Project>
	<PropertyGroup Condition="'$(IsTestProject)' != 'true'">
		<EnableNETAnalyzers Condition="'$(EnableNETAnalyzers)' == ''">true</EnableNETAnalyzers>
		<AnalysisLevel Condition="'$(AnalysisLevel)' == ''">8.0-recommended</AnalysisLevel>
	</PropertyGroup>

	<!--
		Editor engine: an editor binding project and its test project state their engine once, as EditorEngine
		(Wpf or Avalonia). The shared source of an Avalonia project selects its branch with AVALONIAEDIT, and an
		Avalonia test project takes the headless test packages.
	-->
	<PropertyGroup Condition="'$(EditorEngine)' == 'Avalonia'">
		<DefineConstants>$(DefineConstants);AVALONIAEDIT</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(EditorEngine)' == 'Avalonia' and '$(IsTestProject)' == 'true'">
		<PackageReference Include="Avalonia.Headless" />
		<PackageReference Include="Avalonia.Skia" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
	</ItemGroup>

	<!--
		Package-boundary guard: no Nickelony.IDEKit.*, Nickelony.KeyBindings.*, Nickelony.QuickPick.* or
		Nickelony.Matching package may reference the workspace document-authority package, because the AvalonEdit-to-Workspace bridge is host-owned code.
		Nickelony.IDEKit.Workspace.Views references it by design, and test projects are exempt.
	-->
	<Target
		Name="GuardNoWorkspacePackageReferences"
		AfterTargets="ResolveProjectReferences"
		Condition="($(MSBuildProjectName.StartsWith('Nickelony.IDEKit.')) or $(MSBuildProjectName.StartsWith('Nickelony.KeyBindings')) or $(MSBuildProjectName.StartsWith('Nickelony.QuickPick')) or $(MSBuildProjectName.StartsWith('Nickelony.Matching'))) and !$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectName)' != 'Nickelony.IDEKit.Workspace.Views'"
	>
		<Error
			Condition="'%(ProjectReference.Filename)' == 'Nickelony.IDEKit.Workspace'"
			Text="'$(MSBuildProjectName)' must not reference Nickelony.IDEKit.Workspace. The AvalonEdit-to-Workspace bridge is host-owned code, not a package dependency."
		/>
		<Error
			Condition="'%(PackageReference.Identity)' == 'Nickelony.IDEKit.Workspace'"
			Text="'$(MSBuildProjectName)' must not reference Nickelony.IDEKit.Workspace. The AvalonEdit-to-Workspace bridge is host-owned code, not a package dependency."
		/>
	</Target>

	<!--
		C13: a library await states ConfigureAwait(false), because a host may block on the task from a UI thread. A project that
		sets RequireConfigureAwait gets CA2007 as an error, so a bare await fails its build. A project that resumes on the captured
		context, such as an editor binding or a controller package, leaves it unset and states ConfigureAwait(true), which
		AwaitContextGuardTests keeps.
	-->
	<ItemGroup Condition="'$(RequireConfigureAwait)' == 'true'">
		<EditorConfigFiles Include="$(MSBuildThisFileDirectory)ConfigureAwait.globalconfig" />
	</ItemGroup>

	<!--
		Host-agnostic guard: a package on the host-agnostic list must not gain a UI-framework dependency, move
		to a -windows TFM, or reference a package on the WPF-typed or Avalonia-typed list.
	-->
	<PropertyGroup>
		<!-- Each list is wrapped in separators so a Contains(';name;') test matches every entry, including the first. -->
		<HostAgnosticPackageNames>;Nickelony.IDEKit.Core;Nickelony.IDEKit.LanguageFeatures;Nickelony.IDEKit.LanguageFeatures.Controllers;Nickelony.IDEKit.JsonSchema;Nickelony.IDEKit.Markdown;Nickelony.IDEKit.TextMate;Nickelony.KeyBindings;Nickelony.QuickPick;Nickelony.Matching;Nickelony.IDEKit.Processes;Nickelony.IDEKit.FileWatching;Nickelony.IDEKit.Workspace;Nickelony.IDEKit.Workspace.QuickPick;Nickelony.IDEKit.Workspace.Views;Nickelony.LanguageServer.Provider.Abstractions;Nickelony.LanguageServer.Client;Nickelony.LanguageServer.Provider;Nickelony.LanguageServer.Lua;Nickelony.LanguageServer.Roslyn;</HostAgnosticPackageNames>
		<WpfTypedPackageNames>;Nickelony.IDEKit.AvalonEdit;Nickelony.IDEKit.AvalonEdit.LanguageFeatures;Nickelony.IDEKit.AvalonEdit.Markdown;Nickelony.IDEKit.AvalonEdit.TextMate;Nickelony.KeyBindings.Wpf;Nickelony.QuickPick.Wpf;</WpfTypedPackageNames>
		<AvaloniaTypedPackageNames>;Nickelony.IDEKit.AvaloniaEdit;Nickelony.IDEKit.AvaloniaEdit.LanguageFeatures;Nickelony.IDEKit.AvaloniaEdit.Markdown;Nickelony.IDEKit.AvaloniaEdit.TextMate;Nickelony.KeyBindings.Avalonia;Nickelony.QuickPick.Avalonia;</AvaloniaTypedPackageNames>
		<UiFrameworkPackageNames>;AvalonEdit;Avalonia;Avalonia.AvaloniaEdit;Avalonia.Headless;Avalonia.Skia;Avalonia.Themes.Fluent;</UiFrameworkPackageNames>
	</PropertyGroup>

	<Target Name="GuardHostAgnosticPackages" BeforeTargets="CoreCompile" Condition="$(HostAgnosticPackageNames.Contains(';$(MSBuildProjectName);'))">
		<Error
			Condition="'$(UseWPF)' == 'true' or '$(UseWindowsForms)' == 'true'"
			Text="'$(MSBuildProjectName)' is declared host-agnostic and must not enable WPF or Windows Forms."
		/>
		<Error
			Condition="$(TargetFramework.Contains('-windows'))"
			Text="'$(MSBuildProjectName)' is declared host-agnostic and must not target a -windows framework."
		/>
		<Error
			Condition="$(WpfTypedPackageNames.Contains(';%(ProjectReference.Filename);'))"
			Text="'$(MSBuildProjectName)' is declared host-agnostic and must not reference '%(ProjectReference.Filename)', which is a WPF-typed package."
		/>
		<Error
			Condition="$(AvaloniaTypedPackageNames.Contains(';%(ProjectReference.Filename);'))"
			Text="'$(MSBuildProjectName)' is declared host-agnostic and must not reference '%(ProjectReference.Filename)', which is an Avalonia-typed package."
		/>
		<Error
			Condition="$(UiFrameworkPackageNames.Contains(';%(PackageReference.Identity);'))"
			Text="'$(MSBuildProjectName)' is declared host-agnostic and must not reference '%(PackageReference.Identity)', a UI-framework package."
		/>
	</Target>

	<!--
		Every package of the family ships at one version, and the family changes its public surface between
		previews, so a host that mixes versions should fail at restore and not at run time with a
		MissingMethodException or a TypeLoadException. Pack writes a dependency on another in-repo package as
		an exact range, [version], where NuGet's default is the open range from that version up. A
		third-party dependency keeps the range its PackageReference item states.
	-->
	<Target Name="PinProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
		<ItemGroup>
			<_ProjectReferencesWithVersions>
				<ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
			</_ProjectReferencesWithVersions>
		</ItemGroup>
	</Target>
</Project>
